{
  "luci-app-log-viewer": {
    "description": "Grant access to log-viewer procedures",
    "read": {
      "cgi-io": [
        "exec"
      ],
      "file": {
        "/sbin/logread*": [
          "exec"
        ],
        "/usr/sbin/logread*": [
          "exec"
        ],
        "/usr/bin/flint4-geoip": [
          "exec"
        ],
        "/etc/log-viewer/policies.json": [
          "read"
        ]
      }
    }
  }
}
