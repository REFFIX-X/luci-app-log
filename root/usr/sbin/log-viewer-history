#!/bin/sh
# Keep a tmpfs ring of firewall log lines so other syslog cannot evict them.
set -eu

RING="${LOG_VIEWER_RING:-/tmp/log-viewer/events.ring}"
CAP="${LOG_VIEWER_RING_CAP:-500}"
case "$CAP" in ''|*[!0-9]*) CAP=500 ;; esac

status() {
  count=0
  if [ -f "$RING" ]; then
    count="$(wc -l < "$RING" | tr -d '[:space:]')"
    case "$count" in ''|*[!0-9]*) count=0 ;; esac
  fi
  printf '{"count":%s,"cap":%s,"storage":"tmpfs"}\n' "$count" "$CAP"
}

is_firewall_line() {
  line="$1"
  if printf '%s' "$line" | grep -Eq 'INFRA_PORT_(HIT|OTHER):'; then
    return 0
  fi
  printf '%s' "$line" | grep -q 'SRC=' || return 1
  printf '%s' "$line" | grep -Eq 'DPT=[0-9]+' || return 1
  printf '%s' "$line" | grep -Eq 'DROP|REJECT|BLOCK|ALLOW|ACCEPT|PASS' || return 1
  return 0
}

read_log() {
  if command -v logread >/dev/null 2>&1; then
    logread -l 1500 2>/dev/null || true
    return 0
  fi
  for bin in /sbin/logread /usr/sbin/logread /usr/libexec/logread-ubox; do
    if [ -x "$bin" ]; then
      "$bin" -l 1500 2>/dev/null || true
      return 0
    fi
  done
  return 0
}

update() {
  mkdir -p "$(dirname "$RING")"
  merged="$(mktemp)"
  next="$(mktemp)"
  if [ -f "$RING" ]; then
    cat "$RING" >> "$merged"
  fi
  read_log | while IFS= read -r line; do
    if is_firewall_line "$line"; then
      printf '%s\n' "$line"
    fi
  done >> "$merged"
  awk 'NF && !seen[$0]++' "$merged" | tail -n "$CAP" > "$next"
  mv "$next" "$RING"
  rm -f "$merged"
  status
}

clear_ring() {
  rm -f "$RING"
  status
}

follow() {
  while true; do
    update >/dev/null || true
    sleep 15
  done
}

case "${1:-}" in
  update) update ;;
  status) status ;;
  clear) clear_ring ;;
  follow) follow ;;
  *) echo 'usage: log-viewer-history {update|status|clear|follow}' >&2; exit 2 ;;
esac
