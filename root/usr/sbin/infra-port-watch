#!/bin/sh
# Log-only WAN port watcher. It never accepts or drops traffic.
set -eu

# OpenWrt's /lib/functions.sh references IPKG_INSTROOT in config helpers,
# including during normal runtime when package managers leave it unset.
# Initialize it before sourcing that library so nounset cannot abort startup.
IPKG_INSTROOT="${IPKG_INSTROOT:-}"

CONFIG=infra-port-watch.main
MATCH_CHAIN=REFFIX_INFRA_WATCH
LOG_CHAIN=INFRA_PORT_LOG
FWD_CHAIN=INFRA_PORT_FWD
OTHER_CHAIN=INFRA_PORT_OTHER
RATE_NOTE=/tmp/log-viewer/watch-rate
. /lib/functions.sh
. /usr/share/libubox/jshn.sh

uci_get() { uci -q get "$1" 2>/dev/null || true; }

resolve_wan() {
	configured="$(uci_get "$CONFIG.wan_interface")"
	[ -n "$configured" ] || configured=auto
	if [ "$configured" = auto ]; then
		command -v ubus >/dev/null 2>&1 || return 1
		command -v jsonfilter >/dev/null 2>&1 || return 1
		status="$(ubus call network.interface.wan status 2>/dev/null)"
		configured="$(printf '%s' "$status" | jsonfilter -e '@.device' 2>/dev/null | head -n 1)"
		[ -n "$configured" ] || configured="$(printf '%s' "$status" | jsonfilter -e '@.l3_device' 2>/dev/null | head -n 1)"
	fi
	case "$configured" in
		''|*[!a-zA-Z0-9_.:-]*) return 1 ;;
	esac
	printf '%s\n' "$configured"
}

remove_legacy_rules() {
	# Remove the previous script's direct PREROUTING jumps during migration.
	legacy_groups='
21,22,23,25,53,69,80,81,110,111
123,135,137,138,139,143,161,162,179,389
427,443,445,465,500,502,514,515,520,548
554,587,631,636,873,902,989,990,993,995
1080,1194,1433,1434,1521,1701,1723,1883,1900,2049
2082,2083,2181,2222,2375,2376,2483,2484,3000,3128
3268,3306,3389,3690,4444,4500,5000,5001,5060,5061
5432,5555,5601,5672,5900,5985,5986,6379,6443,6667
7001,7070,7443,7777,8000,8008,8080,8081,8088,8443
8888,9000,9042,9090,9200,9300,9418,10000,11211,27017
'
	for iface in "$WAN_IF" eth2; do
		for ports in $legacy_groups; do
			while iptables -t raw -D PREROUTING -i "$iface" -p tcp -m multiport --dports "$ports" -m tcp --syn -j "$LOG_CHAIN" 2>/dev/null; do :; done
			while iptables -t raw -D PREROUTING -i "$iface" -p udp -m multiport --dports "$ports" -j "$LOG_CHAIN" 2>/dev/null; do :; done
		done
	done
}

remove_rules() {
	command -v iptables >/dev/null 2>&1 || return 0
	while iptables -t raw -D PREROUTING -j "$MATCH_CHAIN" 2>/dev/null; do :; done
	iptables -t raw -F "$MATCH_CHAIN" 2>/dev/null || true
	iptables -t raw -X "$MATCH_CHAIN" 2>/dev/null || true
	iptables -t raw -F "$LOG_CHAIN" 2>/dev/null || true
	iptables -t raw -X "$LOG_CHAIN" 2>/dev/null || true
	iptables -t raw -F "$FWD_CHAIN" 2>/dev/null || true
	iptables -t raw -X "$FWD_CHAIN" 2>/dev/null || true
	iptables -t raw -F "$OTHER_CHAIN" 2>/dev/null || true
	iptables -t raw -X "$OTHER_CHAIN" 2>/dev/null || true
}

remember_forward_port() {
	port="$1"
	case "$port" in ''|*[!0-9]*) return 0 ;; esac
	[ "$port" -ge 1 ] 2>/dev/null && [ "$port" -le 65535 ] 2>/dev/null || return 0
	case " $FORWARD_PORTS " in *" $port "*) return 0 ;; esac
	FORWARD_PORTS="${FORWARD_PORTS:+$FORWARD_PORTS }$port"
}

add_forward_spec() {
	spec="$(printf '%s' "$1" | tr ',' ' ')"
	for token in $spec; do
		case "$token" in
			*-*)
				start="${token%-*}"
				end="${token#*-}"
				case "$start$end" in *[!0-9]*) continue ;; esac
				[ "$end" -ge "$start" ] 2>/dev/null || continue
				span=$((end - start + 1))
				# A huge redirect range is not a single exposed service.
				[ "$span" -le 64 ] || continue
				port="$start"
				while [ "$port" -le "$end" ]; do
					remember_forward_port "$port"
					port=$((port + 1))
				done
				;;
			*) remember_forward_port "$token" ;;
		esac
	done
}

collect_forward_port() {
	section="$1"
	config_get forward_enabled "$section" enabled 1
	[ "$forward_enabled" = 0 ] && return 0
	config_get target "$section" target DNAT
	[ "$target" = DNAT ] || return 0
	config_get source_ports "$section" src_dport
	[ -n "$source_ports" ] || return 0
	add_forward_spec "$source_ports"
}

load_forward_ports() {
	FORWARD_PORTS=""
	CONFIG_SECTIONS="${CONFIG_SECTIONS:-}"
	config_load firewall || return 0
	config_foreach collect_forward_port redirect
}

split_port_budgets() {
	SCAN_PORTS=""
	FWD_PORTS=""
	for port in $NORMALIZED_PORTS; do
		case " $FORWARD_PORTS " in
			*" $port "*) FWD_PORTS="${FWD_PORTS:+$FWD_PORTS }$port" ;;
			*) SCAN_PORTS="${SCAN_PORTS:+$SCAN_PORTS }$port" ;;
		esac
	done
}

load_ports() {
	ports="$(uci_get "$CONFIG.ports")"
	[ -n "$ports" ] || ports="21 22 23 25 53 69 80 81 110 111 123 135 137 138 139 143 161 162 179 389 427 443 445 465 500 502 514 515 520 548 554 587 631 636 873 902 989 990 993 995 1080 1194 1433 1434 1521 1701 1723 1883 1900 2049 2082 2083 2181 2222 2375 2376 2483 2484 3000 3128 3268 3306 3389 3690 4444 4500 5000 5001 5060 5061 5432 5555 5601 5672 5900 5985 5986 6379 6443 6667 7001 7070 7443 7547 7777 8000 8008 8080 8081 8088 8291 8443 8883 8888 9000 9042 9090 9200 9300 9418 10000 10250 11211 27017 51820"
	ports="$(printf '%s' "$ports" | tr ',\n\t' '   ')"
	NORMALIZED_PORTS=""
	for port in $ports; do
		case "$port" in ''|*[!0-9]*|??????*) continue ;; esac
		[ "$port" -ge 1 ] 2>/dev/null && [ "$port" -le 65535 ] 2>/dev/null || continue
		case " $NORMALIZED_PORTS " in *" $port "*) continue ;; esac
		NORMALIZED_PORTS="${NORMALIZED_PORTS:+$NORMALIZED_PORTS }$port"
	done
}

install_groups() {
	protocol="$1"
	list="$2"
	chain="$3"
	group=""
	count=0
	for port in $list; do
		if [ "$count" -ge 15 ]; then
			add_group_rule "$protocol" "$group" "$chain"
			group=""
			count=0
		fi
		group="${group:+$group,}$port"
		count=$((count + 1))
	done
	[ -z "$group" ] || add_group_rule "$protocol" "$group" "$chain"
}

add_group_rule() {
	protocol="$1"
	ports="$2"
	chain="$3"
	# goto: a listed port returns to PREROUTING from the log chain, so it does not
	# also match the low-rate rule later in MATCH_CHAIN.
	if [ "$protocol" = tcp ]; then
		iptables -t raw -A "$MATCH_CHAIN" -i "$WAN_IF" -p tcp -m multiport --dports "$ports" -m tcp --syn -g "$chain"
	else
		iptables -t raw -A "$MATCH_CHAIN" -i "$WAN_IF" -p udp -m multiport --dports "$ports" -g "$chain"
	fi
}

install_log_chain() {
	chain="$1"
	table="$2"
	rate="$3"
	burst="$4"
	prefix="$5"
	iptables -t raw -N "$chain" 2>/dev/null || true
	iptables -t raw -F "$chain" || return 1
	if iptables -t raw -A "$chain" -m hashlimit \
		--hashlimit-name "$table" \
		--hashlimit-mode srcip \
		--hashlimit-upto "$rate" \
		--hashlimit-burst "$burst" \
		--hashlimit-htable-expire 120000 \
		-j LOG --log-prefix "$prefix" --log-level 4
	then
		:
	else
		LOG_MODE=shared
		iptables -t raw -A "$chain" -m limit --limit "$rate" --limit-burst "$burst" \
			-j LOG --log-prefix "$prefix" --log-level 4 || return 1
	fi
	iptables -t raw -A "$chain" -j RETURN || return 1
}

apply_rules() {
	command -v iptables >/dev/null 2>&1 || {
		[ "$(uci_get "$CONFIG.enabled")" != 0 ] || return 0
		echo 'iptables is unavailable; WAN port logging was not enabled.' >&2
		return 1
	}
	resolved_wan="$(resolve_wan 2>/dev/null || true)"
	WAN_IF="${resolved_wan:-eth2}"
	load_ports
	remove_legacy_rules
	[ "$(uci_get "$CONFIG.enabled")" != 0 ] || { remove_rules; return 0; }
	[ -n "$resolved_wan" ] || { echo 'Unable to resolve the configured WAN interface.' >&2; return 1; }
	WAN_IF="$resolved_wan"
	[ -n "$NORMALIZED_PORTS" ] || { echo 'The WAN watch port list is empty.' >&2; return 1; }
	load_forward_ports
	split_port_budgets
	remove_rules
	LOG_MODE=per-source
	iptables -t raw -N "$MATCH_CHAIN" 2>/dev/null || true
	iptables -t raw -F "$MATCH_CHAIN" || return 1
	install_log_chain "$LOG_CHAIN" reffix_scan 30/minute 15 'INFRA_PORT_HIT: ' || return 1
	install_log_chain "$FWD_CHAIN" reffix_fwd 4/minute 4 'INFRA_PORT_HIT: ' || return 1
	install_log_chain "$OTHER_CHAIN" reffix_other 2/minute 5 'INFRA_PORT_OTHER: ' || return 1
	mkdir -p /tmp/log-viewer
	printf '%s\n' "$LOG_MODE" > "$RATE_NOTE"
	[ -z "$SCAN_PORTS" ] || { install_groups tcp "$SCAN_PORTS" "$LOG_CHAIN"; install_groups udp "$SCAN_PORTS" "$LOG_CHAIN"; }
	[ -z "$FWD_PORTS" ] || { install_groups tcp "$FWD_PORTS" "$FWD_CHAIN"; install_groups udp "$FWD_PORTS" "$FWD_CHAIN"; }
	iptables -t raw -A "$MATCH_CHAIN" -i "$WAN_IF" -p tcp -m tcp --syn -j "$OTHER_CHAIN" || return 1
	iptables -t raw -A "$MATCH_CHAIN" -i "$WAN_IF" -p udp -j "$OTHER_CHAIN" || return 1
	iptables -t raw -A "$MATCH_CHAIN" -j RETURN || return 1
	iptables -t raw -I PREROUTING 1 -j "$MATCH_CHAIN" || return 1
	echo "INFRA_PORT_WATCH installed on $WAN_IF"
}

print_config() {
	enabled="$(uci_get "$CONFIG.enabled")"; [ -n "$enabled" ] || enabled=1
	wan="$(uci_get "$CONFIG.wan_interface")"; [ -n "$wan" ] || wan=auto
	load_ports
	active=""
	if [ "$enabled" = 1 ]; then active="$(resolve_wan 2>/dev/null || true)"; fi
	ports_json="$(printf '%s' "$NORMALIZED_PORTS" | awk '{ for (i=1;i<=NF;i++) printf "%s%s", (i==1?"":","), $i }')"
	installed=0
	if [ "$enabled" = 1 ] && [ -n "$active" ] && command -v iptables >/dev/null 2>&1 &&
		iptables -t raw -C PREROUTING -j "$MATCH_CHAIN" 2>/dev/null; then installed=1; fi
	json_init
	json_add_boolean enabled "$([ "$enabled" = 1 ] && echo 1 || echo 0)"
	json_add_string wan_interface "$wan"
	json_add_string active_interface "$active"
	json_add_string ports "$ports_json"
	json_add_string router_time "$(date +%s 2>/dev/null || echo 0)"
	json_add_string router_offset "$(date +%z 2>/dev/null || echo '')"
	json_add_boolean installed "$installed"
	json_add_string address_family 'IPv4 only'
	rate_mode="$(cat "$RATE_NOTE" 2>/dev/null || echo per-source)"
	if [ "$rate_mode" = shared ]; then
		json_add_string log_rate 'shared fallback, hashlimit unavailable: 30 per minute, forwarded ports 4 per minute, other ports 2 per minute'
	else
		json_add_string log_rate '30 per minute per source after burst of 15; forwarded ports 4 per minute per source; other ports 2 per minute per source after burst of 5'
	fi
	json_add_array redirects
	# A missing firewall config must not hide WAN watch status.
	CONFIG_SECTIONS="${CONFIG_SECTIONS:-}"
	config_load firewall || true
	config_foreach add_redirect redirect
	json_close_array
	json_dump
}

add_redirect() {
	section="$1"
	config_get redirect_enabled "$section" enabled 1
	[ "$redirect_enabled" = 0 ] && return 0
	config_get target "$section" target DNAT
	[ "$target" = DNAT ] || return 0
	config_get source_zone "$section" src
	config_get source_ports "$section" src_dport
	[ -n "$source_zone" ] && [ -n "$source_ports" ] || return 0
	config_get name "$section" name
	config_get protocol "$section" proto tcp
	config_get destination_port "$section" dest_port
	json_add_object
	json_add_string name "$name"
	json_add_string source_zone "$source_zone"
	json_add_string source_ports "$source_ports"
	json_add_string destination_port "$destination_port"
	json_add_string protocol "$protocol"
	json_close_object
}

case "${1:-}" in
	get) print_config ;;
	apply) apply_rules ;;
	remove) remove_rules ;;
	*) echo 'usage: infra-port-watch {get|apply|remove}' >&2; exit 2 ;;
esac
