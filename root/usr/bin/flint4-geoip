#!/bin/sh
# Local MaxMind GeoLite2 lookup and database status. Requires libmaxminddb (mmdblookup).
set -e
country_db="${GEOIP_DB_DIR:-/usr/share/GeoIP}/GeoLite2-Country.mmdb"
asn_db="${GEOIP_DB_DIR:-/usr/share/GeoIP}/GeoLite2-ASN.mmdb"

if [ "$#" -eq 1 ] && [ "$1" = "--status" ]; then
  available=false
  age_days=null
  stale=false
  if [ -s "$country_db" ] && [ -s "$asn_db" ] && command -v mmdblookup >/dev/null 2>&1; then
    country_time="$(stat -c %Y "$country_db" 2>/dev/null || echo 0)"
    asn_time="$(stat -c %Y "$asn_db" 2>/dev/null || echo 0)"
    case "$country_time" in ''|*[!0-9]*) country_time=0 ;; esac
    case "$asn_time" in ''|*[!0-9]*) asn_time=0 ;; esac
    older_time="$country_time"
    [ "$asn_time" -ge "$older_time" ] || older_time="$asn_time"
    now="$(date +%s 2>/dev/null || echo 0)"
    case "$older_time:$now" in *[!0-9:]*|:*) older_time=0 ;; esac
    if [ "$older_time" -gt 0 ] && [ "$now" -ge "$older_time" ]; then
      age_days=$(( (now - older_time) / 86400 ))
      [ "$age_days" -le 45 ] || stale=true
    fi
    available=true
  fi
  printf '{"available":%s,"age_days":%s,"stale":%s}\n' "$available" "$age_days" "$stale"
  exit 0
fi

if [ "$#" -ne 2 ] || [ "$1" != "--json" ]; then
  echo '{"error":"usage: flint4-geoip --json IP"}'
  exit 2
fi
ip="$2"
case "$ip" in *[!0-9a-fA-F:.]*) echo '{"error":"invalid IP"}'; exit 2;; esac

cc=""
country=""
asn=""

if [ -s "$country_db" ] && command -v mmdblookup >/dev/null 2>&1; then
  cc="$(mmdblookup --file "$country_db" --ip "$ip" country iso_code 2>/dev/null | sed -n 's/.*"\([A-Z][A-Z]\)".*/\1/p' | head -n1 || true)"
  country="$(mmdblookup --file "$country_db" --ip "$ip" country names en 2>/dev/null | sed -n 's/.*"\(.*\)".*/\1/p' | head -n1 || true)"
fi
if [ -s "$asn_db" ] && command -v mmdblookup >/dev/null 2>&1; then
  asn="$(mmdblookup --file "$asn_db" --ip "$ip" autonomous_system_organization 2>/dev/null | sed -n 's/.*"\(.*\)".*/\1/p' | head -n1 || true)"
fi

json_escape() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr -d '\r\n'
}
printf '{"country_code":"%s","country_name":"%s","asn_organization":"%s"}\n' \
  "$(json_escape "$cc")" "$(json_escape "$country")" "$(json_escape "$asn")"
